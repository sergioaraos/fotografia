<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Aprender Fotografia de Cero</title>
    <link rel="stylesheet" href="/static/style.css">
</head>
<body>
    <div class="layout">
        <nav class="menu">
            <h1><a href="/">Aprender Fotografia de Cero</a></h1>
            <% arbol.forEach(function(cap) { %>
            <details class="capitulo" <%= cap.capitulo.id === activeCapituloId ? 'open' : '' %>>
                <summary class="<%= (paginaActualTipo === 'capitulo' && paginaActualId === cap.capitulo.id) ? 'activo' : '' %>">
                    <a href="/capitulo/<%= cap.capitulo.slug %>"><%= cap.capitulo.titulo %></a>
                </summary>
                <% if (cap.subcapitulos.length === 0) { %>
                <p class="vacio">Sin subcapitulos todavia</p>
                <% } %>
                <% cap.subcapitulos.forEach(function(sub) { %>
                <details class="subcapitulo" <%= sub.subcapitulo.id === activeSubcapituloId ? 'open' : '' %>>
                    <summary class="<%= (paginaActualTipo === 'subcapitulo' && paginaActualId === sub.subcapitulo.id) ? 'activo' : '' %>">
                        <a href="/subcapitulo/<%= sub.subcapitulo.slug %>"><%= sub.subcapitulo.titulo %></a>
                    </summary>
                    <ul>
                        <% sub.temas.forEach(function(t) { %>
                        <li class="<%= t.completado ? 'completado' : (!t.desbloqueado ? 'bloqueado' : '') %> <%= t.tema.id === activeTemaId ? 'activo' : '' %>">
                            <% if (t.desbloqueado) { %>
                            <a href="/tema/<%= t.tema.slug %>">
                                <% if (t.completado) { %>
                                <svg class="icon-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                                <% } %>
                                <%= t.tema.titulo %>
                            </a>
                            <% } else { %>
                            <span>
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                                <%= t.tema.titulo %>
                            </span>
                            <% } %>
                        </li>
                        <% }); %>
                    </ul>
                </details>
                <% }); %>
            </details>
            <% }); %>
            <% if (arbol.length === 0) { %>
            <p class="vacio">Sin capitulos cargados todavia</p>
            <% } %>
            <form method="post" action="/logout" style="margin-top: 1.5rem;">
                <button type="submit" style="background:transparent;color:var(--muted);border:1px solid var(--border);">Cerrar sesion</button>
            </form>
        </nav>
        <main class="contenido">
